<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción que añade la opción 'Imprimir' dentro de la vista de taller.orden -->
    <record id="action_report_taller_orden" model="ir.actions.report">
        <field name="name">Orden de Trabajo / Presupuesto</field>
        <field name="model">taller.orden</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">taller_mecanico.report_taller_orden_template</field>
        <field name="report_file">taller_mecanico.report_taller_orden_template</field>
        <field name="print_report_name">'Orden_' + (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_taller_orden" />
        <field name="binding_type">report</field>
    </record>

    <!-- Plantilla QWeb del reporte -->
    <template id="report_taller_orden_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Cabecera de la Orden -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>
                                    <strong>ORDEN DE TRABAJO</strong>
                                </h2>
                                <h4>
                                    <span t-field="doc.name" />
                                </h4>
                            </div>
                        </div>

                        <!-- Bloque Datos Cliente / Vehículo -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="card p-2 border-secondary">
                                    <h5 class="card-title text-primary">
                                        <strong>Cliente</strong>
                                    </h5>
                                    <strong>Nombre:</strong>
                                    <span t-field="doc.partner_id.name" />
                                    <br />
                                    <strong>RIF/Cédula:</strong>
                                    <span t-field="doc.partner_id.vat" />
                                    <br />
                                    <strong>Teléfono:</strong>
                                    <span t-field="doc.partner_id.phone" />
                                    <br />
                                    <strong>Correo:</strong>
                                    <span t-field="doc.partner_id.email" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card p-2 border-secondary">
                                    <h5 class="card-title text-primary">
                                        <strong>Vehículo</strong>
                                    </h5>
                                    <strong>
                                    Placa:</strong> <span t-field="doc.vehicle_id.license_plate" /><br />
                                    <strong>Marca
                                    / Modelo:</strong> <span t-field="doc.vehicle_id.brand" /> <span
                                        t-field="doc.vehicle_id.model" /><br />
                                    <strong>Año:</strong> <span
                                        t-field="doc.vehicle_id.year" /><br />
                                    <strong>Kilometraje:</strong> <span
                                        t-field="doc.vehicle_id.mileage" /> km </div>
                            </div>
                        </div>

                        <!-- Diagnóstico -->
                        <div t-if="doc.diagnosis" class="row mb-4">
                            <div class="col-12">
                                <h5>
                                    <strong>Diagnóstico / Falla Reportada:</strong>
                                </h5>
                                <div class="p-2 border rounded bg-light">
                                    <p t-field="doc.diagnosis" class="m-0" />
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de Ítems (line_ids) -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <h5>
                                    <strong>Trabajos y Repuestos:</strong>
                                </h5>
                                <table class="table table-sm table-striped border">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Producto / Servicio</th>
                                            <th>Descripción</th>
                                            <th class="text-end">Cantidad</th>
                                            <th class="text-end">P. Unitario ($)</th>
                                            <th class="text-end">Subtotal ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.line_ids" t-as="line">
                                            <td>
                                                <span t-field="line.product_id.name" />
                                            </td>
                                            <td>
                                                <span t-field="line.name" />
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.quantity" />
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.price_unit" />
                                            </td>
                                            <td class="text-end">
                                                <span t-field="line.subtotal" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Total -->
                        <div class="row justify-content-end">
                            <div class="col-5">
                                <table class="table table-sm border">
                                    <tr class="table-active">
                                        <td>
                                            <strong>TOTAL:</strong>
                                        </td>
                                        <td class="text-end">
                                            <strong><span t-field="doc.amount_total" /> $</strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Firmas -->
                        <div class="row mt-5 pt-4 text-center">
                            <div class="col-6"> ___________________________________<br />
                                <strong>Firma
                                del Cliente</strong>
                            </div>
                            <div class="col-6"> ___________________________________<br />
                                <strong>Recepción
                                del Taller</strong>
                            </div>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>