<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario -->
    <record id="view_taller_orden_form" model="ir.ui.view">
        <field name="name">taller.orden.form</field>
        <field name="model">taller.orden</field>
        <field name="arch" type="xml">
            <form string="Orden de Trabajo">
                <header>
                    <button name="action_in_progress" string="Iniciar Trabajos" type="object"
                        class="oe_highlight" invisible="state != 'draft'" />
                    <button name="action_waiting_parts" string="En Espera de Repuestos"
                        type="object" invisible="state != 'in_progress'" />
                    <button name="action_ready" string="Listo para Entrega" type="object"
                        class="oe_highlight"
                        invisible="state not in ('in_progress', 'waiting_parts')" />
                    <button name="action_done" string="Entregar / Finalizar" type="object"
                        class="oe_highlight" invisible="state != 'ready'" />
                    <button name="action_cancel" string="Cancelar" type="object"
                        invisible="state in ('done', 'cancel')" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,waiting_parts,ready,done" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Cliente y Vehículo">
                            <field name="partner_id" />
                            <field name="vehicle_id" />
                        </group>
                        <group string="Detalles de Recepción">
                            <field name="date_entry" />
                            <field name="date_delivery_expected" />
                            <field name="user_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Trabajos y Repuestos" name="lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="price_unit" />
                                    <field name="subtotal" />
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="amount_total" class="oe_subtotal_footer_separator" />
                            </group>
                        </page>
                        <page string="Diagnóstico u Observaciones" name="diagnosis">
                            <group>
                                <field name="diagnosis"
                                    placeholder="Describe la falla reportada o diagnóstico inicial..." />
                                <field name="notes" placeholder="Notas internas del taller..." />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Vista Lista (Tree) -->
    <record id="view_taller_orden_tree" model="ir.ui.view">
        <field name="name">taller.orden.list</field>
        <field name="model">taller.orden</field>
        <field name="arch" type="xml">
            <tree string="Órdenes de Trabajo">
                <field name="name" />
                <field name="partner_id" />
                <field name="vehicle_id" />
                <field name="date_entry" />
                <field name="user_id" />
                <field name="amount_total" sum="Total" />
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                    decoration-warning="state in ('in_progress', 'waiting_parts')"
                    decoration-success="state in ('ready', 'done')"
                    decoration-danger="state == 'cancel'" />
            </tree>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_taller_orden_kanban" model="ir.ui.view">
        <field name="name">taller.orden.kanban</field>
        <field name="model">taller.orden</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name" />
                                </strong>
                                <span class="badge rounded-pill text-bg-secondary"> $<field
                                        name="amount_total" />
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>Cliente:</strong>
                                    <field name="partner_id" />
                                </div>
                                <div>
                                    <strong>Vehículo:</strong>
                                    <field name="vehicle_id" />
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <field name="date_entry" />
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id" widget="many2one_avatar_user" />
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_taller_orden" model="ir.actions.act_window">
        <field name="name">Órdenes de Trabajo</field>
        <field name="res_model">taller.orden</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera Orden de Trabajo
            </p>
        </field>
    </record>

    <!-- Menú de Órdenes -->
    <menuitem id="menu_taller_orden"
        name="Órdenes de Trabajo"
        parent="menu_taller_root"
        action="action_taller_orden"
        sequence="10" />

</odoo>